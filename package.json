{
  "name": "komatal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore,hosting",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project komatal-e2e \"playwright test\""
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@iconify-json/lucide": "^1.2.140",
    "@nuxt/ui": "^4.11.3",
    "firebase": "^12.19.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "~1.63",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.32.1",
    "typescript": "~5.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
